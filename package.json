{
  "name": "nexus-analytics",
  "version": "1.0.0",
  "private": true,
  "description": "NEXUS ANALYTICS — outil d'analyse des performances League of Legends (API Riot Games)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "lucide-react": "0.525.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.7",
    "recharts": "2.15.4",
    "tsx": "4.20.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.11",
    "@types/express": "4.17.23",
    "@types/node": "22.15.30",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.6.0",
    "concurrently": "9.2.0",
    "cross-env": "7.0.3",
    "tailwindcss": "4.1.11",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
