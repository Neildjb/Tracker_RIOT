# Modèle de configuration — copier ce fichier en ".env" puis remplir RIOT_API_KEY.
# Ce fichier est publié sur GitHub : n'y mettez JAMAIS de vraie clé. La clé va uniquement dans .env (ignoré par Git).

# Clé API Riot Games — à obtenir sur https://developer.riotgames.com
# Sans clé, l'application démarre en MODE DÉMO (données fictives).
RIOT_API_KEY=

# Port du backend (le frontend Vite proxifie /api vers ce port)
API_PORT=3001

# Nombre de parties récupérées par profil (1-50). 20 respecte la limite d'une clé de développement.
MATCH_COUNT=20

# Derrière un hébergeur (Render, Railway…) : 1. En local : 0.
TRUST_PROXY=0
